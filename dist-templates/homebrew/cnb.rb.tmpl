# frozen_string_literal: true
#
# Homebrew formula template for cnb CLI.
#
# This file is committed for reference; the actual formula lives in the
# external tap repository (e.g. `cnb-cool/homebrew-tap`). To cut a release:
#
#   1. Run release CI; collect SHA-256 digests for the four Unix archives:
#        - cnb-vX.Y.Z-x86_64-apple-darwin.tar.gz
#        - cnb-vX.Y.Z-aarch64-apple-darwin.tar.gz
#        - cnb-vX.Y.Z-x86_64-unknown-linux-gnu.tar.gz
#        - cnb-vX.Y.Z-aarch64-unknown-linux-gnu.tar.gz
#   2. Substitute %VERSION% and the four %SHA256_*% placeholders below.
#   3. Commit the rendered file as `Formula/cnb.rb` in the tap repo.
#
# Users then install via:
#   brew tap cnb-cool/tap
#   brew install cnb

class Cnb < Formula
  desc "Official command-line tool for CNB (CloudNative Build, cnb.cool)"
  homepage "https://cnb.cool"
  version "%VERSION%"
  license "MIT OR Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/cnb-cool/cnb/releases/download/v#{version}/cnb-v#{version}-aarch64-apple-darwin.tar.gz"
      sha256 "%SHA256_DARWIN_ARM64%"
    else
      url "https://github.com/cnb-cool/cnb/releases/download/v#{version}/cnb-v#{version}-x86_64-apple-darwin.tar.gz"
      sha256 "%SHA256_DARWIN_AMD64%"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/cnb-cool/cnb/releases/download/v#{version}/cnb-v#{version}-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "%SHA256_LINUX_ARM64%"
    else
      url "https://github.com/cnb-cool/cnb/releases/download/v#{version}/cnb-v#{version}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "%SHA256_LINUX_AMD64%"
    end
  end

  def install
    bin.install "cnb"

    # Man pages (section 1) — files are named cnb.1, cnb-auth.1, cnb-repo.1, ...
    if (buildpath/"man").directory?
      Dir["man/*.1"].each { |m| man1.install m }
    end

    # Shell completions
    if (buildpath/"completions").directory?
      bash_completion.install "completions/cnb.bash"   => "cnb" if File.exist?("completions/cnb.bash")
      zsh_completion.install  "completions/_cnb"             if File.exist?("completions/_cnb")
      fish_completion.install "completions/cnb.fish"         if File.exist?("completions/cnb.fish")
    end
  end

  test do
    assert_match "cnb #{version}", shell_output("#{bin}/cnb --version")
  end
end
